<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!-- Carpeta del servidor con latest.manifest y los zip de cada version (solo lectura para los clientes). -->
    <add key="RutaActualizacion" value="\\192.168.1.3\sgesystem\SISTEMA\actualizador" />
    <!-- Donde se instala SIGEFA en cada PC. Vacio = %LocalAppData%\SIGEFA -->
    <add key="CarpetaInstalacion" value="" />
    <!-- Segundos que se espera al servidor antes de abrir la version ya instalada -->
    <add key="EsperaServidorSegundos" value="8" />
  </appSettings>
</configuration>
