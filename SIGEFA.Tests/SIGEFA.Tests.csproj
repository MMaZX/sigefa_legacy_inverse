<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MySql.Data">
      <HintPath>..\..\Debug_gr\MySql.Data.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\Debug_gr\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Se enlazan los fuentes del helper: referenciar SIGEFA.exe arrastraria Crystal y WinForms -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Conexion\Db\*.cs" Link="Db\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Se enlazan las reglas puras de requerimientos de venta (sin BD ni WinForms) -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\ReqVenta\*.cs" Link="ReqVenta\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Bitacora del cierre de venta: solo lo puro. Se enlazan los dos DTO del progreso, nunca VentaCierreService (arrastra MySql y WinForms) -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\VentaCierreBitacora\*.cs" Link="VentaCierreBitacora\%(Filename)%(Extension)" />
    <Compile Include="..\SIGEFA.Administradores\VentaCierre\VentaCierrePaso.cs" Link="VentaCierre\VentaCierrePaso.cs" />
    <Compile Include="..\SIGEFA.Administradores\VentaCierre\VentaCierreProgreso.cs" Link="VentaCierre\VentaCierreProgreso.cs" />
  </ItemGroup>
  <!-- Consulta de DNI/RUC en SUNAT: se enlaza todo (parser puro y cliente HTTP sin BD) -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\ConsultaDocumento\*.cs" Link="ConsultaDocumento\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Texto de version del login -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\VersionApp\*.cs" Link="VersionApp\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Regla pura de stock por linea de venta (servicios sin stock) -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\VentaServicios\*.cs" Link="VentaServicios\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Tracker puro de cambios del detalle de plantilla; la entidad se enlaza porque no depende de nada -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\PlantillaCambios\*.cs" Link="PlantillaCambios\%(Filename)%(Extension)" />
    <Compile Include="..\SIGEFA.Entidades\clsDetallePlantillaDeProductos.cs" Link="PlantillaCambios\clsDetallePlantillaDeProductos.cs" />
  </ItemGroup>
  <!-- Diagnostico puro de errores al cargar un pedido pendiente en la venta -->
  <ItemGroup>
    <Compile Include="..\SIGEFA.Administradores\PedidoPendiente\*.cs" Link="PedidoPendiente\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
